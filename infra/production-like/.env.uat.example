# Level UAT reference values (RC-2 / NT-2, 2026-09-03).
#
# RC-2b: these values are auto-exported by `X8_LEVEL=uat` (see
# scripts/lib/x8-levels.json, read by both scripts/lib/x8-production-like-env.sh
# and scripts/acceptance/x8-validate-compose.mjs). This file is a
# cross-reference copy only — set `export X8_LEVEL=uat` before
# `scripts/x8-production-like.sh up`/`verify`/`accept` to get these values for
# real; do not point `docker compose --env-file` at this file.
#
# Every value below is the Level UAT row from docs/p2/V020_RELEASE_CHECKLIST.md
# "## 3. Flag 分级开放" → "### Level UAT：Owner 本地真实验收（不对外）"; the
# inline comments cite which checklist bullet each line came from so this file
# and the checklist cannot silently drift apart.
#
# No secrets: every credential/key variable below is a placeholder. Real
# MoboReader credentials go in only through the /channel-accounts UI's
# addOrReplaceCredential entry point; encryption/fingerprint key files and
# TOTP key are generated locally under .tmp/x8-production-like/secrets/ by
# prepare_x8_environment() — i.e. by `scripts/x8-production-like.sh up` and
# every other subcommand that calls it, NOT by `setup`, which only touches
# mkcert and /etc/hosts — and must never be copied here.

# --- Catalog sync double-gate (checklist Level UAT, bullet 2) ---
FEATURE_NOVEL_CATALOG_SYNC=true
NOVEL_CATALOG_SYNC_ALLOW_WRITE=true

# --- Promo link claim double-gate (checklist Level UAT, bullet 3) ---
FEATURE_PROMO_LINK_CLAIM=true
PROMO_LINK_CLAIM_ALLOW_WRITE=true

# --- promo:claim admin capability grant (checklist Level UAT, PROMO_CLAIM_ROLES
# bullet). NOT a double-gate: the two flags above decide whether the feature is
# on, this decides whether the logged-in admin may use it. Without it the
# /catalog-sync claim dialog can only run dry_run. Empty everywhere else
# (defaultRoles: [] in src/lib/auth/capabilities.ts). ---
PROMO_CLAIM_ROLES=super_admin
PROMO_CLAIM_USER_IDS=

# --- Worker allowlist (checklist Level UAT, bullet 4) ---
# Level 0's three entries plus preview_refresh (C2b accepted, see the
# checklist's Level 0 C2b bullet evidence) plus the claim task type. Must
# change in the SAME edit as the two double-gates above.
WORKER_TASK_ALLOWLIST=credential.validate.v1,credential.supersede.v1,catalog_scan,moboreader.preview_refresh.v1,promo_link.claim.v1

# --- IndexNow / Sitemap stay at Level 0 (checklist Level UAT, bullet 5) ---
FEATURE_INDEXNOW_OUTBOX=false
INDEXNOW_OUTBOX_ALLOW_WRITE=false
FEATURE_INDEXNOW_DELIVERY=false
INDEXNOW_DELIVERY_ALLOW_WRITE=false
FEATURE_SITEMAP_AUTO_REFRESH=false
SITEMAP_AUTO_REFRESH_ALLOW_WRITE=false

# --- X8 local topology constants (unchanged from prepare_x8_environment(),
# repeated here only so this file reads as a complete Level UAT snapshot) ---
SITE_URL=https://novel.test
ADMIN_CANONICAL_ORIGIN=https://novel.test
TZ=Asia/Tokyo
MOBOREADER_PREVIEW_SOURCE_APP_CODES=changdu

# --- Credential / key material: placeholders only ---
# Filled by the setup script, never by hand, never committed with a value.
CHANNEL_CREDENTIAL_ACTIVE_KEY_VERSION=1
CHANNEL_CREDENTIAL_ENCRYPTION_KEY_V1_FILE=
CHANNEL_CREDENTIAL_FINGERPRINT_KEY_FILE=
TOTP_ENCRYPTION_KEY=
# Real MoboReader JWT: entered once through /channel-accounts
# addOrReplaceCredential. Never place it in this file, a CLI argument, shell
# history, or any evidence artifact.

# --- Not an env var: catalog-sync page-range ceiling (checklist Level UAT,
# page-range bullet). RC-3 is merged, so pageSize is now machine-enforced at 20
# (MOBOREADER_CATALOG_LIMITS.maxPageSize; anything larger is rejected as
# page_size_exceeded). The page count <= 3 has no env knob and no hard ceiling —
# it stays an operator discipline enforced by hand in the UI form. ---
