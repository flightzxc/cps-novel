# X8 public, non-secret operator knobs. Runtime secrets are generated under
# .tmp/x8-production-like/ and must never be copied into this file.
X8_HTTP_PORT=80
X8_HTTPS_PORT=443
X8_NGINX_IMAGE=nginx:1.28.0-alpine
X8_BACKUP_INTERVAL_SECONDS=86400
X8_BACKUP_RUN_ON_START=true

# 独立轻量通道；与主 worker 白名单互斥。
WORKER_LANE=main
WORKER_LIGHT_ID=cps-novel-worker-light-1
WORKER_LIGHT_TASK_ALLOWLIST=sitemap_refresh,sitemap.daily_fallback.v1,home_carousel.compute.v1
