# P1-06/X2 reference only. This is a repository configuration contract, not
# evidence that a production cluster has loaded it. Follow the PostgreSQL
# hardening runbook to install, restart, create the extension, and verify.
max_connections = 100
log_min_duration_statement = 500ms
shared_preload_libraries = 'pg_stat_statements'
compute_query_id = auto
pg_stat_statements.track = all

wal_level = replica
archive_mode = on
archive_timeout = '15min'
archive_command = 'P1_06_WAL_ARCHIVE_DIR=/var/lib/postgresql/wal-archive /app/scripts/db/archive-wal.sh "%p" "%f"'
max_wal_senders = 4
wal_compression = on
log_checkpoints = on
