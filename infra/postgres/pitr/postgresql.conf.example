# P1-06 reference only. Production values must be injected by P1-12 deployment.
wal_level = replica
archive_mode = on
archive_timeout = '15min'
archive_command = 'P1_06_WAL_ARCHIVE_DIR=/var/lib/postgresql/wal-archive /app/scripts/db/archive-wal.sh "%p" "%f"'
max_wal_senders = 4
wal_compression = on
log_checkpoints = on
