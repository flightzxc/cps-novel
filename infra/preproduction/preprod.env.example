# Non-secret preproduction deployment contract. Real values live only in
# /opt/cps-novel/shared/env/preprod.env on the target host.
# 🔴 CPS_NOVEL_APP_IMAGE 与 GIT_COMMIT **刻意不在这里定义**。
# 它们的唯一真源是 release manifest；写在这个共享 env 里会在每次发布时把
# manifest 指定的新版本悄悄覆盖回旧版本，而容器照样起得来、只是跑的是上一版。
# lib.sh 的 preprod_load_env() 会检测这种覆盖并直接失败。
#
# 只读的 compose 命令（如 `preprod_compose ps`）需要该变量时，在命令行临时给：
#   CPS_NOVEL_APP_IMAGE=cps-novel:<version>-<short> preprod_compose ps
APP_VERSION=0.1.0
BUILD_DATE=REQUIRED_ISO_8601
NEXT_PUBLIC_BUILD_VERSION=v0.1.0
P1_12_COMPOSE_PROJECT=cps-novel
P1_12_WEB_PORT=3000
PREPROD_SHARED_ROOT=/opt/cps-novel/shared
SITE_URL=https://www.bangbangji.cloud
ADMIN_CANONICAL_ORIGIN=https://zbcwf.bangbangji.cloud
TZ=Asia/Tokyo
WORKER_ID=cps-novel-preprod-worker-1
WORKER_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
WORKER_STOP_GRACE_PERIOD=45s
SCHEDULER_INTERVAL_SECONDS=60
ADMIN_TWO_FACTOR_ENFORCEMENT=true
PUBLIC_TRACKING_WRITE_DISABLED=1
WORKER_TASK_ALLOWLIST=credential.validate.v1,credential.supersede.v1,home_carousel.compute.v1
FEATURE_NOVEL_CATALOG_SYNC=false
NOVEL_CATALOG_SYNC_ALLOW_WRITE=false
FEATURE_INDEXNOW_OUTBOX=false
INDEXNOW_OUTBOX_ALLOW_WRITE=false
FEATURE_INDEXNOW_DELIVERY=false
INDEXNOW_DELIVERY_ALLOW_WRITE=false
FEATURE_SITEMAP_AUTO_REFRESH=false
SITEMAP_AUTO_REFRESH_ALLOW_WRITE=false
FEATURE_PROMO_LINK_CLAIM=false
PROMO_LINK_CLAIM_ALLOW_WRITE=false
FEATURE_P2_06_5_TAGGING=true
FEATURE_P2_06_5_TAG_ADMIN_WRITE=false
FEATURE_NOVEL_TAG_AUTO=false
AUTO_WRITE_AUTHORIZED=NO
# Read semantics must be exercised in preproduction; this is not a write gate.
FEATURE_ARTICLE_SEO_VISIBILITY=true
FEATURE_ARTICLE_BLOG=false
ARTICLE_BLOG_ALLOW_WRITE=false
FEATURE_ARTICLE_NOVEL_REBIND=false
ARTICLE_NOVEL_REBIND_ALLOW_WRITE=false
CHANNEL_CREDENTIAL_ACTIVE_KEY_VERSION=1
PREPROD_CURL_CONFIG=/opt/cps-novel/shared/secrets/preprod-curl.conf
PREPROD_ADMIN_USERNAME=REQUIRED_ADMIN_USERNAME
PREPROD_ADMIN_PASSWORD_FILE=/opt/cps-novel/shared/secrets/admin-smoke-password

# URLs contain usernames but no literal passwords; use Docker secret-file
# interpolation when rendering the protected host env file.
P1_12_MIGRATION_DATABASE_URL=REQUIRED
P1_12_WEB_DATABASE_URL=REQUIRED
P1_12_WORKER_DATABASE_URL=REQUIRED
P1_12_SCHEDULER_DATABASE_URL=REQUIRED
P1_12_POSTGRES_ADMIN_PASSWORD_FILE=/opt/cps-novel/shared/secrets/postgres_admin_password
P1_12_MIGRATION_OWNER_PASSWORD_FILE=/opt/cps-novel/shared/secrets/migration_owner_password
P1_12_WEB_APP_PASSWORD_FILE=/opt/cps-novel/shared/secrets/web_app_password
P1_12_WORKER_APP_PASSWORD_FILE=/opt/cps-novel/shared/secrets/worker_app_password
P1_12_SCHEDULER_APP_PASSWORD_FILE=/opt/cps-novel/shared/secrets/scheduler_app_password
P1_12_ANALYST_RO_PASSWORD_FILE=/opt/cps-novel/shared/secrets/analyst_ro_password
P1_12_BACKUP_ROLE_PASSWORD_FILE=/opt/cps-novel/shared/secrets/backup_role_password
CHANNEL_CREDENTIAL_ENCRYPTION_KEY_V1_FILE=/opt/cps-novel/shared/secrets/channel_credential_encryption_key_v1
CHANNEL_CREDENTIAL_FINGERPRINT_KEY_FILE=/opt/cps-novel/shared/secrets/channel_credential_fingerprint_key
