# Non-secret preproduction deployment contract. Real values live only in
# /opt/cps-novel/shared/env/preprod.env on the target host.
# 🔴 CPS_NOVEL_APP_IMAGE 与 GIT_COMMIT **刻意不在这里定义**。
# 它们的唯一真源是 release manifest；写在这个共享 env 里会在每次发布时把
# manifest 指定的新版本悄悄覆盖回旧版本，而容器照样起得来、只是跑的是上一版。
# lib.sh 的 preprod_load_env() 会检测这种覆盖并直接失败。
#
# 只读的 compose 命令（如 `preprod_compose ps`）需要该变量时，在命令行临时给：
#   CPS_NOVEL_APP_IMAGE=cps-novel:<version>-<short> preprod_compose ps
# 🔴 目标机 /opt/cps-novel/shared/env/preprod.env 里的 APP_VERSION 与
# NEXT_PUBLIC_BUILD_VERSION 这两项，必须在部署每个新版本（本版 v0.4.1）之前同步改成与本文件相同的值。
# 镜像内烘焙的 .build-metadata.json 由 Dockerfile 构建参数 APP_VERSION 写入
# （且构建期已断言其与 package.json 一致，见 Dockerfile 第 66 行）；`/api/health`
# 的 metadataConsistency 会在运行期用这里的 APP_VERSION 与烘焙值逐字比对
# （src/server/health/service.ts 的 runtime_version_mismatch），target 机忘同步
# 就会在部署后被健康检查判定为不一致。NEXT_PUBLIC_BUILD_VERSION 不参与该一致性
# 判定（只用于后台侧栏展示），但同样是 Dockerfile 构建期必需的非空参数，一并同步。
APP_VERSION=0.4.1
BUILD_DATE=REQUIRED_ISO_8601
NEXT_PUBLIC_BUILD_VERSION=v0.4.1
P1_12_COMPOSE_PROJECT=cps-novel
P1_12_WEB_PORT=3000
PREPROD_SHARED_ROOT=/opt/cps-novel/shared
SITE_URL=https://www.bangbangji.cloud
ADMIN_CANONICAL_ORIGIN=https://zbcwf.bangbangji.cloud
TZ=Asia/Tokyo
WORKER_ID=cps-novel-preprod-worker-1
WORKER_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
WORKER_STOP_GRACE_PERIOD=45s
# C-13 (2026-09-07, Owner-approved): the upstream catalog quota is charged
# per request rather than per returned row. Preproduction therefore explicitly
# opts into the probed-safe 100 rows/request and 1500ms pacing (~40 requests/min).
# Global application/Compose defaults remain 20/1100; the safety cap stays 2000.
MOBOREADER_UPSTREAM_RECOMMENDED_PAGE_SIZE=100
MOBOREADER_UPSTREAM_MIN_REQUEST_INTERVAL_MS=1500
SCHEDULER_INTERVAL_SECONDS=60
ADMIN_TWO_FACTOR_ENFORCEMENT=true
PUBLIC_TRACKING_WRITE_DISABLED=1
# 2026-09-22 (Owner-approved): the target host (bangbangji.cloud, protected
# preproduction) is no longer a zero-business-data environment. Owner opened
# the catalog-sync write gate on 2026-09-22, then the promo-link-claim write
# gate plus the worker allowlist entries and the admin capability grant below
# on 2026-09-23. Any write gate that is open here MUST also be registered in
# PREPROD_APPROVED_OPEN_WRITE_GATES below, or scripts/preproduction/preflight.sh
# fails closed (see preprod_assert_write_gates() in lib.sh and
# docs/adr/ADR-PREPROD-APPROVED-OPEN-WRITE-GATES.md). Opening any OTHER write
# gate requires first adding it to that function's closed enum and getting
# Owner approval -- an env edit alone is not enough.
WORKER_TASK_ALLOWLIST=credential.validate.v1,credential.supersede.v1,home_carousel.compute.v1,catalog_scan,promo_link.claim.v1,batch.materialize.v1,novel.materialize.v1
FEATURE_NOVEL_CATALOG_SYNC=true
NOVEL_CATALOG_SYNC_ALLOW_WRITE=true
FEATURE_INDEXNOW_OUTBOX=false
INDEXNOW_OUTBOX_ALLOW_WRITE=false
FEATURE_INDEXNOW_DELIVERY=false
INDEXNOW_DELIVERY_ALLOW_WRITE=false
FEATURE_SITEMAP_AUTO_REFRESH=false
SITEMAP_AUTO_REFRESH_ALLOW_WRITE=false
FEATURE_PROMO_LINK_CLAIM=true
PROMO_LINK_CLAIM_ALLOW_WRITE=true
# Closed enum, only these two names are accepted -- see preprod_assert_write_gates()
# in scripts/preproduction/lib.sh. Upgrading an existing host to this template
# version: add this line to /opt/cps-novel/shared/env/preprod.env BEFORE
# deploying this version, or the new preflight fails reason=catalog_write.
PREPROD_APPROVED_OPEN_WRITE_GATES=catalog_write,promo_write
# 阶段2（`docs/adr/ADR-PROMO-CLAIM-BATCH-LIFECYCLE.md`）：领推广链接批次的
# "批次 → 分片 → 条目"生命周期与自动分片。七项配置，机器真源见
# `src/lib/tasks/promo-claim-lifecycle.ts` 的 `PROMO_CLAIM_LIFECYCLE_ENV`/
# `PROMO_CLAIM_LIFECYCLE_DEFAULTS`——下面每一行的取值都与该文件的默认值
# 逐字相同，因此本节整体注释掉也不改变任何行为（同 `resolvePromoClaimLifecycleConfig`
# 在环境变量缺失时的回落值）。
#
# 🔴 开关默认关闭（D8），本模板同样保持默认关闭——这不是这两个写闸
# （catalog_write/promo_write）的一部分，是它们之上再叠一层：写闸开着只表示
# "允许写"，生命周期开关决定新提交的批次走旧的"提交时算 6 小时"逻辑，还是
# 本阶段的"批次→分片→条目"逻辑。二者独立，互不隐含。
#
# 预生产 UAT 要开启这个开关，必须先经 Owner 批准（同 catalog_write/promo_write
# 写闸开启走的同一道 Owner 批准记录，见 docs/adr/ADR-PREPROD-APPROVED-OPEN-WRITE-GATES.md
# 与设计 §5.1 的上线路径："预生产显式开启 → 完整 UAT → 8 万级模拟与真实验收通过 →
# 再决定各目标环境的配置"）。批准后的操作方式是**改目标机 env、只重建三个应用
# 服务，不是发新版**：
#   1. 编辑目标机 /opt/cps-novel/shared/env/preprod.env，把
#      PROMO_CLAIM_LIFECYCLE_V1_ENABLED 改成 "true"（需要调整放行窗口/分片
#      大小/凭据安全余量做 UAT 场景时，同一处一并改下面几项数值）；
#   2. `source scripts/preproduction/lib.sh && scripts/preproduction/preflight.sh`
#      重新跑一遍——阶段2 第5步起，preflight 会用与
#      `resolvePromoClaimLifecycleConfig` 逐条一致的规则校验这七项配置
#      （`preprod_assert_promo_claim_lifecycle_config()`，见 lib.sh 该函数的
#      说明），配置笔误在这一步就 fail closed，不会等到进程跑起来才在
#      scheduler 日志里发现；
#   3. `CPS_NOVEL_APP_IMAGE` 不变（没有新镜像、没有新 commit，`GIT_COMMIT`
#      也不变）——只让已经在跑的应用进程重新读取这几个环境变量：
#      `source scripts/preproduction/lib.sh` 后依次调用
#      `preprod_compose_app_up web`、`preprod_compose_app_up worker`、
#      `preprod_compose_app_up scheduler`（`up -d --no-deps`，Compose 侦测到
#      服务自身配置变化会重建该容器，postgres 与其它服务不受影响，不必停机、
#      不必跑任何 migration）。
#      关闭开关（紧急回退）用完全相同的三步，只是第 1 步把值改回 "false"——
#      设计 §5.1：已按新生命周期创建的批次进入系统暂停 `lifecycle_disabled`，
#      已经放行的那一个分片正常跑完，不会有任何条目被改写成失败。
PROMO_CLAIM_LIFECYCLE_V1_ENABLED=false
PROMO_CLAIM_BATCH_APPROVAL_TTL_MINUTES=1440
PROMO_CLAIM_SHARD_WINDOW_MINUTES=90
PROMO_CLAIM_SHARD_SIZE_MAX=1000
PROMO_CLAIM_SHARD_SIZE_MIN=50
PROMO_CLAIM_CREDENTIAL_SAFETY_MARGIN_MINUTES=30
# 阶段4-A（设计《领推广按接口限速与预读集合化 · 阶段4-5》§5.4/§十三）：把
# 上面 MOBOREADER_UPSTREAM_MIN_REQUEST_INTERVAL_MS 那一个共享节流闸门拆成
# 按接口（getlistpc/getcode）各一个，外加主机级防突发间隔与按
# x-ratelimit-remaining 自适应减速。机器真源见
# `src/lib/adapters/moboreader-rate-limit.ts` 的
# `MOBOREADER_UPSTREAM_PER_ENDPOINT_RATE_GATE_ENV`/
# `MOBOREADER_PER_ENDPOINT_RATE_GATE_DEFAULTS`——下面每一行都与该文件默认值
# 逐字相同，本节整体注释掉不改变任何行为。
#
# 🔴 开关默认关闭，本模板同样保持默认关闭：**开启须 Owner 批准**（同
# catalog_write/promo_write 写闸开启走的同一道批准记录）。此前 v0.4.2 组装
# 时发现过一次事故：只在这份 env 里把开关设成 true，`preflight.sh` 照样
# 打印 enabled=true（它只校验这些值本身合法，不管有没有透传进容器）,
# 但如果 docker-compose.yml 的 worker 服务没有把这些变量透传进容器，容器里
# 读到的仍是"未设置"、开关形同虚设——本仓库这处透传已经补上
# （tests/backend/runtime/p1-12-compose-contract.test.ts 有契约测试防止再次
# 漏配），但改任何一层时都要留意这条链路：env 文件 → compose 透传 →
# 容器内 process.env，三处必须一致。
#
# 🔴 首次开启的爬坡顺序（E1）：先把两个接口间隔都设成 1500ms 跑 24 小时，
# 观察 rate_gate.* 与 upstream_call 的 endpointGateWaitMs/remainingBeforeDispatch
# 指标无异常，再降到下面的推荐默认 1200ms（E2）——不要一上来就用 1200。
# 间隔低于 1000ms 会被 preflight 拒绝。
#
# 🔴 余量地板必须 ≥ 1（0 会被 preflight 拒绝）：地板是 getcode 撞 429（=
# 结果不明，按冻结规则只许回读、不许再发 getcode）之前的主动减速保险，
# 配成 0 等于把这道保险整个关掉。
#
# Retry-After 异常阈值：上游 429 的 Retry-After 永远原值冷却、绝不截短；
# 这个数只决定超过多少算"异常"而额外发一条 rate_gate.cooldown_anomaly
# 观测事件供运维关注，本身不改变实际冷却时长。
MOBOREADER_UPSTREAM_PER_ENDPOINT_RATE_GATE_ENABLED=false
MOBOREADER_UPSTREAM_MIN_REQUEST_INTERVAL_MS__GETLISTPC=1200
MOBOREADER_UPSTREAM_MIN_REQUEST_INTERVAL_MS__GETCODE=1200
MOBOREADER_UPSTREAM_HOST_MIN_GAP_MS=250
MOBOREADER_UPSTREAM_REMAINING_FLOOR__GETLISTPC=8
MOBOREADER_UPSTREAM_REMAINING_FLOOR__GETCODE=12
MOBOREADER_UPSTREAM_RATE_WINDOW_MAX_WAIT_MS=60000
MOBOREADER_UPSTREAM_RETRY_AFTER_ANOMALY_THRESHOLD_MS=900000
FEATURE_P2_06_5_TAGGING=true
FEATURE_P2_06_5_TAG_ADMIN_WRITE=false
FEATURE_NOVEL_TAG_AUTO=false
AUTO_WRITE_AUTHORIZED=NO
# Read semantics must be exercised in preproduction; this is not a write gate.
FEATURE_ARTICLE_SEO_VISIBILITY=true
FEATURE_ARTICLE_BLOG=false
ARTICLE_BLOG_ALLOW_WRITE=false
FEATURE_ARTICLE_NOVEL_REBIND=false
ARTICLE_NOVEL_REBIND_ALLOW_WRITE=false
CHANNEL_CREDENTIAL_ACTIVE_KEY_VERSION=1
# 2026-09-23 (Owner-approved): the promo:claim admin capability is granted to
# exactly one identity -- the admin user -- via PROMO_CLAIM_USER_IDS, not via
# PROMO_CLAIM_ROLES. src/lib/auth/capabilities.ts defines promo:claim with
# defaultRoles: [] (no role grants it access by default), so leaving both
# empty means nobody can claim promo links; this is the deliberate choice
# over the broader role-based grant. The real UUID is per-environment and
# lives only on the target host, never in this repo.
PROMO_CLAIM_ROLES=
PROMO_CLAIM_USER_IDS=REQUIRED_ADMIN_IDENTITY_UUID
PREPROD_CURL_CONFIG=/opt/cps-novel/shared/secrets/preprod-curl.conf
PREPROD_ADMIN_USERNAME=REQUIRED_ADMIN_USERNAME
PREPROD_ADMIN_PASSWORD_FILE=/opt/cps-novel/shared/secrets/admin-smoke-password

# URLs contain usernames but no literal passwords; use Docker secret-file
# interpolation when rendering the protected host env file.
P1_12_MIGRATION_DATABASE_URL=REQUIRED
P1_12_WEB_DATABASE_URL=REQUIRED
P1_12_WORKER_DATABASE_URL=REQUIRED
P1_12_SCHEDULER_DATABASE_URL=REQUIRED
P1_12_POSTGRES_ADMIN_PASSWORD_FILE=/opt/cps-novel/shared/secrets/postgres_admin_password
P1_12_MIGRATION_OWNER_PASSWORD_FILE=/opt/cps-novel/shared/secrets/migration_owner_password
P1_12_WEB_APP_PASSWORD_FILE=/opt/cps-novel/shared/secrets/web_app_password
P1_12_WORKER_APP_PASSWORD_FILE=/opt/cps-novel/shared/secrets/worker_app_password
P1_12_SCHEDULER_APP_PASSWORD_FILE=/opt/cps-novel/shared/secrets/scheduler_app_password
P1_12_ANALYST_RO_PASSWORD_FILE=/opt/cps-novel/shared/secrets/analyst_ro_password
P1_12_BACKUP_ROLE_PASSWORD_FILE=/opt/cps-novel/shared/secrets/backup_role_password
CHANNEL_CREDENTIAL_ENCRYPTION_KEY_V1_FILE=/opt/cps-novel/shared/secrets/channel_credential_encryption_key_v1
CHANNEL_CREDENTIAL_FINGERPRINT_KEY_FILE=/opt/cps-novel/shared/secrets/channel_credential_fingerprint_key
