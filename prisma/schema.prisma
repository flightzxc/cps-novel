  batchId      String?  @map("batch_id") @db.Uuid
  mergedAt     DateTime @map("merged_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  novel      Novel                   @relation(fields: [novelId], references: [id], onDelete: Restrict)
  article    Article                 @relation(fields: [articleId], references: [id], onDelete: Restrict)
  manualSlot HomeCarouselManualSlot? @relation(fields: [manualSlotId], references: [id], onDelete: SetNull)
  batch      HomeCarouselAutoBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([locale, position], map: "carousel_serving_locale_position_key")
  @@index([articleId], map: "carousel_serving_article_idx")
  @@map("home_carousel_serving")
}

model HomeCarouselChangeLog {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  locale       String   @db.VarChar(16)
  action       String   @db.VarChar(64)
  manualSlotId String?  @map("manual_slot_id") @db.Uuid
  actorType    String   @map("actor_type") @db.VarChar(32)
  actorId      String?  @map("actor_id") @db.VarChar(128)
  beforeState  Json?    @map("before_state") @db.JsonB
  afterState   Json?    @map("after_state") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([locale, createdAt], map: "carousel_change_locale_created_idx")
  @@index([manualSlotId], map: "carousel_change_manual_slot_idx")
  @@map("home_carousel_change_log")
}
