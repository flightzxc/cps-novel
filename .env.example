# cps-novel production Compose contract
# Copy to a protected deployment env file and replace every REQUIRED value.
# Never commit real credentials, encryption material, or password files.

# Immutable image and build identity (REQUIRED)
CPS_NOVEL_APP_IMAGE=
P1_12_NODE_BASE_IMAGE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
APP_VERSION=0.1.0
GIT_COMMIT=
BUILD_DATE=
NEXT_PUBLIC_BUILD_VERSION=v0.1.0
P1_12_COMPOSE_PROJECT=cps-novel-production
P1_12_WEB_PORT=3000

# Runtime origins and process identity (REQUIRED unless marked optional)
# Production origin is frozen (2026-09-03, Owner): SITE_URL=https://pulsenovels.com
# This is documentation only -- there is no runtime default. getSiteUrl()
# (src/lib/seo/site-url.ts) fails fast whenever SITE_URL is unset or malformed;
# do not add a fallback here or in code. See
# docs/operations/PRODUCTION_DOMAIN_2026-09-03.md for the single-source
# contract and consumer list.
# X8 local production-like UAT does NOT read this file's SITE_URL -- it is
# always https://novel.test, exported by scripts/lib/x8-production-like-env.sh
# (X8_LOCAL_DOMAIN). Never set SITE_URL=https://pulsenovels.com for local X8.
SITE_URL=
# Admin same-origin enforcement (src/app/api/admin/_lib/deps.ts) AND
# admin-host isolation (src/proxy.ts, RC-9, 2026-09-03 Owner). Production
# admin origin is a dedicated subdomain (the `zbcwf` prefix CPS also uses):
# Production admin origin is frozen (2026-09-03, Owner, RC-9): ADMIN_CANONICAL_ORIGIN=https://zbcwf.pulsenovels.com
# This MUST resolve to a different host than SITE_URL. src/proxy.ts fails
# closed on that invariant: if the two ever resolve to the same host in
# production, every admin path (ADMIN_PAGE_ROOTS, /login, /two-factor,
# /api/admin) answers 404 on every host rather than becoming reachable from
# the public origin -- the public short-drama sister site's defect (its
# public domain can open its admin login page) must never recur here.
# Documentation only -- there is no default and no Host-header fallback; X8
# exports https://zbcwf.novel.test for this and https://novel.test for
# SITE_URL, independently of this file.
ADMIN_CANONICAL_ORIGIN=
TZ=Asia/Tokyo
TRACKING_HASH_SALT=
# RC-6 /go redirect tracking write safety valve. Empty/unset = writes ON (default;
# /go is this project's only public attribution signal, so it must stay open).
# This default is deliberately the opposite of CPS, which ships
# CPS_PUBLIC_TRACKING_WRITE_DISABLED=1 because it has other attribution signals.
# Set to 1 / true / yes / on (case-insensitive, surrounding spaces ignored --
# the same accepted set as CPS isTruthyEnv) to stop writing TrackingEvent rows
# from /go without changing any redirect behavior (302/404 and the target URL
# are unaffected) -- use during an abuse spike or DB write pressure.
# Any other value (0, false, blank, typo) means NOT disabled: writes stay on.
PUBLIC_TRACKING_WRITE_DISABLED=
WORKER_ID=cps-novel-worker-1
WORKER_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
SCHEDULER_INTERVAL_SECONDS=60
# Fixed inside the image/Compose volume. Listed here so operations do not invent a second path.
SITEMAP_STATIC_DIR=/app/runtime/static-sitemaps
# RC-7b /api/health/backup inputs. Both are read by the web container only, and
# both are optional: with neither set the endpoint answers 200 backupStatus
# "unconfigured", which an UptimeRobot Keyword monitor still treats as an alert.
# BACKUP_STATUS_FILE is a JSON file with { finishedAt, exitCode } written by a
# future backup script -- it takes priority and is the only source that can ever
# report "failed" (a non-zero exit code). Absent that file, the endpoint falls
# back to the newest *.dump / *.sql artifact's mtime in BACKUP_OUTPUT_DIR, which
# must be the SAME mount as the backup container's X8_BACKUP_OUTPUT_DIR or the
# endpoint stays "unconfigured" forever. Threshold defaults to CPS's 26h.
BACKUP_STATUS_FILE=
BACKUP_OUTPUT_DIR=
BACKUP_STALE_THRESHOLD_HOURS=

# Role-scoped PostgreSQL URLs (REQUIRED; use distinct credentials)
P1_12_MIGRATION_DATABASE_URL=
P1_12_WEB_DATABASE_URL=
P1_12_WORKER_DATABASE_URL=
P1_12_SCHEDULER_DATABASE_URL=

# Host paths to Docker secret files (REQUIRED; mode 0600 recommended)
P1_12_POSTGRES_ADMIN_PASSWORD_FILE=
P1_12_MIGRATION_OWNER_PASSWORD_FILE=
P1_12_WEB_APP_PASSWORD_FILE=
P1_12_WORKER_APP_PASSWORD_FILE=
P1_12_SCHEDULER_APP_PASSWORD_FILE=
P1_12_ANALYST_RO_PASSWORD_FILE=
P1_12_BACKUP_ROLE_PASSWORD_FILE=

# Credential key selection and host paths (REQUIRED)
# ACTIVE is non-secret. Key material must remain in these files; there is no env fallback.
CHANNEL_CREDENTIAL_ACTIVE_KEY_VERSION=1
CHANNEL_CREDENTIAL_ENCRYPTION_KEY_V1_FILE=
CHANNEL_CREDENTIAL_FINGERPRINT_KEY_FILE=

# Other encryption material (REQUIRED; unchanged by P0-1)
TOTP_ENCRYPTION_KEY=

# Admin capabilities. Start with super_admin and widen only through an audited change.
CREDENTIAL_MANAGE_ROLES=super_admin
CREDENTIAL_MANAGE_USER_IDS=
CONTENT_VIEW_ROLES=super_admin
CONTENT_VIEW_USER_IDS=
CONTENT_READ_ROLES=super_admin
CONTENT_READ_USER_IDS=
CONTENT_PUBLISH_ROLES=super_admin
CONTENT_PUBLISH_USER_IDS=
SETTINGS_MANAGE_ROLES=super_admin
SETTINGS_MANAGE_USER_IDS=
TASK_MANAGE_ROLES=super_admin
TASK_MANAGE_USER_IDS=
# promo:claim is deliberately granted to NOBODY by default (defaultRoles: [] in
# src/lib/auth/capabilities.ts, requiresTwoFactor). It is the capability the
# /catalog-sync "领取推广链接" dialog checks before it will run in apply mode, and
# it is separate from the FEATURE_PROMO_LINK_CLAIM / PROMO_LINK_CLAIM_ALLOW_WRITE
# double-gate: both must be on for a real claim. Leave empty except where a real
# claim is intended (X8_LEVEL=uat sets it automatically for the local topology).
PROMO_CLAIM_ROLES=
PROMO_CLAIM_USER_IDS=

# Worker consumption is REQUIRED and has no Compose default.
# Level 0 launch value (exact): credential lifecycle plus catalog scan only.
WORKER_TASK_ALLOWLIST=credential.validate.v1,credential.supersede.v1,catalog_scan
# After the C2b parser fix is accepted, append: moboreader.preview_refresh.v1
# With the claim double-gates in the SAME release change, append: promo_link.claim.v1
# With the Sitemap write-gate in the SAME release change, append: sitemap_refresh
# Only after X11 schedule/dedup/misfire=skip/worker-sweep acceptance, and with the
# IndexNow delivery double-gates in the SAME release change, append: indexnow_delivery

# MoboReader task runtime. Preview remains pending while its type is absent above.
MOBOREADER_CATALOG_SAFETY_MAX_PAGES=2000
MOBOREADER_PREVIEW_CHUNK_SIZE=25
MOBOREADER_PREVIEW_CONCURRENCY=2
MOBOREADER_PREVIEW_TIMEOUT_MS=20000
MOBOREADER_PREVIEW_FRESHNESS_MS=86400000
MOBOREADER_PREVIEW_SOURCE_APP_CODES=changdu
# Optional comma-separated emergency narrowing; empty means no item-level narrowing.
MOBOREADER_PREVIEW_SOURCE_ITEM_ALLOWLIST=
# RC-3 upstream request-pacing discipline, ported from CPS v8.3.6
# (see docs/governance/port-registry.md). Defaults equal the CPS-ported
# values; only override for an incident/tuning, never lower
# MOBOREADER_UPSTREAM_MIN_REQUEST_INTERVAL_MS casually — it is what keeps
# this process under the upstream's observed ~60 requests/window ceiling.
# MOBOREADER_UPSTREAM_MIN_REQUEST_INTERVAL_MS=1100
# MOBOREADER_UPSTREAM_MAX_RATE_LIMIT_RETRIES=4
# MOBOREADER_UPSTREAM_BACKOFF_BASE_MS=2000
# MOBOREADER_UPSTREAM_BACKOFF_CAP_MS=60000
# MOBOREADER_UPSTREAM_RETRY_AFTER_CAP_MS=120000
# MOBOREADER_UPSTREAM_RATE_LIMIT_BUDGET_MS=90000
# CPS-parity default page size for a catalog-scan task. The hard ceiling is
# MOBOREADER_CATALOG_LIMITS.maxPageSize in src/lib/tasks/moboreader.ts, also 20
# since the RC-3 fixup; this override may go below it but never above.
# MOBOREADER_UPSTREAM_RECOMMENDED_PAGE_SIZE=20
# Read-only promo readback recovery. Runtime clamps attempts to 1..5 and interval to 0..30000ms.
PROMO_LINK_CLAIM_READBACK_ATTEMPTS=3
PROMO_LINK_CLAIM_READBACK_INTERVAL_MS=2000

# Worker failure reporter (webhook URL optional; URL is never logged)
WORKER_FAILURE_WEBHOOK_URL=
WORKER_FAILURE_WEBHOOK_TIMEOUT_MS=5000
WORKER_FAILURE_WEBHOOK_COOLDOWN_SECONDS=1800

# All five double-gate pairs start closed. Change a task flag and its worker
# allowlist entry only in the same reviewed release change.
FEATURE_NOVEL_CATALOG_SYNC=false
NOVEL_CATALOG_SYNC_ALLOW_WRITE=false
FEATURE_INDEXNOW_OUTBOX=false
INDEXNOW_OUTBOX_ALLOW_WRITE=false
FEATURE_INDEXNOW_DELIVERY=false
INDEXNOW_DELIVERY_ALLOW_WRITE=false
FEATURE_SITEMAP_AUTO_REFRESH=false
SITEMAP_AUTO_REFRESH_ALLOW_WRITE=false
FEATURE_PROMO_LINK_CLAIM=false
PROMO_LINK_CLAIM_ALLOW_WRITE=false
