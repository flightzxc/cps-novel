# cps-novel production Compose contract
# Copy to a protected deployment env file and replace every REQUIRED value.
# Never commit real credentials, encryption material, or password files.

# Immutable image and build identity (REQUIRED)
CPS_NOVEL_APP_IMAGE=
P1_12_NODE_BASE_IMAGE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
APP_VERSION=0.1.0
GIT_COMMIT=
BUILD_DATE=
NEXT_PUBLIC_BUILD_VERSION=v0.1.0
P1_12_COMPOSE_PROJECT=cps-novel-production
P1_12_WEB_PORT=3000

# Runtime origins and process identity (REQUIRED unless marked optional)
SITE_URL=
ADMIN_CANONICAL_ORIGIN=
TZ=Asia/Tokyo
TRACKING_HASH_SALT=
WORKER_ID=cps-novel-worker-1
WORKER_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
SCHEDULER_INTERVAL_SECONDS=60
# Fixed inside the image/Compose volume. Listed here so operations do not invent a second path.
SITEMAP_STATIC_DIR=/app/runtime/static-sitemaps

# Role-scoped PostgreSQL URLs (REQUIRED; use distinct credentials)
P1_12_MIGRATION_DATABASE_URL=
P1_12_WEB_DATABASE_URL=
P1_12_WORKER_DATABASE_URL=
P1_12_SCHEDULER_DATABASE_URL=

# Host paths to Docker secret files (REQUIRED; mode 0600 recommended)
P1_12_POSTGRES_ADMIN_PASSWORD_FILE=
P1_12_MIGRATION_OWNER_PASSWORD_FILE=
P1_12_WEB_APP_PASSWORD_FILE=
P1_12_WORKER_APP_PASSWORD_FILE=
P1_12_SCHEDULER_APP_PASSWORD_FILE=
P1_12_ANALYST_RO_PASSWORD_FILE=
P1_12_BACKUP_ROLE_PASSWORD_FILE=

# Credential key selection and host paths (REQUIRED)
# ACTIVE is non-secret. Key material must remain in these files; there is no env fallback.
CHANNEL_CREDENTIAL_ACTIVE_KEY_VERSION=1
CHANNEL_CREDENTIAL_ENCRYPTION_KEY_V1_FILE=
CHANNEL_CREDENTIAL_FINGERPRINT_KEY_FILE=

# Other encryption material (REQUIRED; unchanged by P0-1)
TOTP_ENCRYPTION_KEY=

# Admin capabilities. Start with super_admin and widen only through an audited change.
CREDENTIAL_MANAGE_ROLES=super_admin
CREDENTIAL_MANAGE_USER_IDS=
CONTENT_VIEW_ROLES=super_admin
CONTENT_VIEW_USER_IDS=
CONTENT_READ_ROLES=super_admin
CONTENT_READ_USER_IDS=
CONTENT_PUBLISH_ROLES=super_admin
CONTENT_PUBLISH_USER_IDS=
SETTINGS_MANAGE_ROLES=super_admin
SETTINGS_MANAGE_USER_IDS=
TASK_MANAGE_ROLES=super_admin
TASK_MANAGE_USER_IDS=

# Worker consumption is REQUIRED and has no Compose default.
# Level 0 launch value (exact): credential lifecycle plus catalog scan only.
WORKER_TASK_ALLOWLIST=credential.validate.v1,credential.supersede.v1,catalog_scan
# After the C2b parser fix is accepted, append: moboreader.preview_refresh.v1
# With the claim double-gates in the SAME release change, append: promo_link.claim.v1
# With the Sitemap write-gate in the SAME release change, append: sitemap_refresh
# Only after X11 schedule/dedup/misfire=skip/worker-sweep acceptance, and with the
# IndexNow delivery double-gates in the SAME release change, append: indexnow_delivery

# MoboReader task runtime. Preview remains pending while its type is absent above.
MOBOREADER_CATALOG_SAFETY_MAX_PAGES=2000
MOBOREADER_PREVIEW_CHUNK_SIZE=25
MOBOREADER_PREVIEW_CONCURRENCY=2
MOBOREADER_PREVIEW_TIMEOUT_MS=20000
MOBOREADER_PREVIEW_FRESHNESS_MS=86400000
MOBOREADER_PREVIEW_SOURCE_APP_CODES=changdu
# Optional comma-separated emergency narrowing; empty means no item-level narrowing.
MOBOREADER_PREVIEW_SOURCE_ITEM_ALLOWLIST=
# Read-only promo readback recovery. Runtime clamps attempts to 1..5 and interval to 0..30000ms.
PROMO_LINK_CLAIM_READBACK_ATTEMPTS=3
PROMO_LINK_CLAIM_READBACK_INTERVAL_MS=2000

# Worker failure reporter (webhook URL optional; URL is never logged)
WORKER_FAILURE_WEBHOOK_URL=
WORKER_FAILURE_WEBHOOK_TIMEOUT_MS=5000
WORKER_FAILURE_WEBHOOK_COOLDOWN_SECONDS=1800

# All five double-gate pairs start closed. Change a task flag and its worker
# allowlist entry only in the same reviewed release change.
FEATURE_NOVEL_CATALOG_SYNC=false
NOVEL_CATALOG_SYNC_ALLOW_WRITE=false
FEATURE_INDEXNOW_OUTBOX=false
INDEXNOW_OUTBOX_ALLOW_WRITE=false
FEATURE_INDEXNOW_DELIVERY=false
INDEXNOW_DELIVERY_ALLOW_WRITE=false
FEATURE_SITEMAP_AUTO_REFRESH=false
SITEMAP_AUTO_REFRESH_ALLOW_WRITE=false
FEATURE_PROMO_LINK_CLAIM=false
PROMO_LINK_CLAIM_ALLOW_WRITE=false
