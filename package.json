{
  "name": "cps-novel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:ui": "vitest run --project ui",
    "test:backend": "vitest run --project node tests/backend",
    "test:integration": "vitest run --project node tests/integration"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "vitest": "^3",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^26",
    "@testing-library/react": "^16",
    "@testing-library/dom": "^10"
  }
}
