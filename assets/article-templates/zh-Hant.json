{
  "templateKey": "system-default-zh-Hant-v1",
  "templateName": "系统默认模板 · 繁体中文",
  "locale": "zh-Hant",
  "version": 1,
  "schemaVersion": 1,
  "status": "active",
  "applicableArticleType": "novel_article",
  "bodyTemplate": "<article><h1>{novel_title}</h1>{if cover_url}<p><img src=\"{cover_url}\" alt=\"封面\"></p>{endif}<p>{novel_description}</p>{if total_chapter_count}<p>總章節數：{total_chapter_count}</p>{endif}{if preview_chapter_count}<p>可用免費試讀章節：{preview_chapter_count}</p>{endif}{if promo_redirect_url}<p><a href=\"{promo_redirect_url}\">開始閱讀</a></p>{endif}</article>",
  "contentTemplate": [
    {
      "type": "heading",
      "content": "{novel_title}"
    },
    {
      "type": "image",
      "content": ""
    },
    {
      "type": "paragraph",
      "content": "{novel_description}"
    },
    {
      "type": "paragraph",
      "content": "{if total_chapter_count}總章節數：{total_chapter_count}{endif}"
    },
    {
      "type": "paragraph",
      "content": "{if preview_chapter_count}可用免費試讀章節：{preview_chapter_count}{endif}"
    },
    {
      "type": "cta",
      "content": "開始閱讀"
    }
  ],
  "seoTemplate": {
    "title": "{novel_title}",
    "metaTitle": "{novel_title}",
    "metaDescription": "{novel_description}"
  },
  "slugTemplate": "",
  "metaKeywordsTemplate": ""
}
