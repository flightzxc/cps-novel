{
  "templateKey": "system-default-fr-v1",
  "templateName": "系统默认模板 · 法文",
  "locale": "fr",
  "version": 1,
  "schemaVersion": 1,
  "status": "active",
  "applicableArticleType": "novel_article",
  "bodyTemplate": "<article><h1>{novel_title}</h1>{if cover_url}<p><img src=\"{cover_url}\" alt=\"Couverture\"></p>{endif}<p>{novel_description}</p>{if total_chapter_count}<p>Nombre total de chapitres : {total_chapter_count}</p>{endif}{if preview_chapter_count}<p>Chapitres d'aperçu gratuits disponibles : {preview_chapter_count}</p>{endif}{if promo_redirect_url}<p><a href=\"{promo_redirect_url}\">Commencer la lecture</a></p>{endif}</article>",
  "contentTemplate": [
    {
      "type": "heading",
      "content": "{novel_title}"
    },
    {
      "type": "image",
      "content": ""
    },
    {
      "type": "paragraph",
      "content": "{novel_description}"
    },
    {
      "type": "paragraph",
      "content": "{if total_chapter_count}Nombre total de chapitres : {total_chapter_count}{endif}"
    },
    {
      "type": "paragraph",
      "content": "{if preview_chapter_count}Chapitres d'aperçu gratuits disponibles : {preview_chapter_count}{endif}"
    },
    {
      "type": "cta",
      "content": "Commencer la lecture"
    }
  ],
  "seoTemplate": {
    "title": "{novel_title}",
    "metaTitle": "{novel_title}",
    "metaDescription": "{novel_description}"
  },
  "slugTemplate": "",
  "metaKeywordsTemplate": ""
}
