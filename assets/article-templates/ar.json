{
  "templateKey": "system-default-ar-v1",
  "templateName": "系统默认模板 · 阿拉伯文",
  "locale": "ar",
  "version": 1,
  "schemaVersion": 1,
  "status": "active",
  "applicableArticleType": "novel_article",
  "bodyTemplate": "<article><h1>{novel_title}</h1>{if cover_url}<p><img src=\"{cover_url}\" alt=\"الغلاف\"></p>{endif}<p>{novel_description}</p>{if total_chapter_count}<p>إجمالي الفصول: {total_chapter_count}</p>{endif}{if preview_chapter_count}<p>فصول المعاينة المجانية المتاحة: {preview_chapter_count}</p>{endif}{if promo_redirect_url}<p><a href=\"{promo_redirect_url}\">ابدأ القراءة</a></p>{endif}</article>",
  "contentTemplate": [
    {
      "type": "heading",
      "content": "{novel_title}"
    },
    {
      "type": "image",
      "content": ""
    },
    {
      "type": "paragraph",
      "content": "{novel_description}"
    },
    {
      "type": "paragraph",
      "content": "{if total_chapter_count}إجمالي الفصول: {total_chapter_count}{endif}"
    },
    {
      "type": "paragraph",
      "content": "{if preview_chapter_count}فصول المعاينة المجانية المتاحة: {preview_chapter_count}{endif}"
    },
    {
      "type": "cta",
      "content": "ابدأ القراءة"
    }
  ],
  "seoTemplate": {
    "title": "{novel_title}",
    "metaTitle": "{novel_title}",
    "metaDescription": "{novel_description}"
  },
  "slugTemplate": "",
  "metaKeywordsTemplate": ""
}
