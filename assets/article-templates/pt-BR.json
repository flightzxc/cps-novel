{
  "templateKey": "system-default-pt-BR-v1",
  "templateName": "系统默认模板 · 葡萄牙文",
  "locale": "pt-BR",
  "version": 1,
  "schemaVersion": 1,
  "status": "active",
  "applicableArticleType": "novel_article",
  "bodyTemplate": "<article><h1>{novel_title}</h1>{if cover_url}<p><img src=\"{cover_url}\" alt=\"Capa\"></p>{endif}<p>{novel_description}</p>{if total_chapter_count}<p>Total de capítulos: {total_chapter_count}</p>{endif}{if preview_chapter_count}<p>Capítulos de pré-visualização gratuitos disponíveis: {preview_chapter_count}</p>{endif}{if promo_redirect_url}<p><a href=\"{promo_redirect_url}\">Começar a ler</a></p>{endif}</article>",
  "contentTemplate": [
    {
      "type": "heading",
      "content": "{novel_title}"
    },
    {
      "type": "image",
      "content": ""
    },
    {
      "type": "paragraph",
      "content": "{novel_description}"
    },
    {
      "type": "paragraph",
      "content": "{if total_chapter_count}Total de capítulos: {total_chapter_count}{endif}"
    },
    {
      "type": "paragraph",
      "content": "{if preview_chapter_count}Capítulos de pré-visualização gratuitos disponíveis: {preview_chapter_count}{endif}"
    },
    {
      "type": "cta",
      "content": "Começar a ler"
    }
  ],
  "seoTemplate": {
    "title": "{novel_title}",
    "metaTitle": "{novel_title}",
    "metaDescription": "{novel_description}"
  },
  "slugTemplate": "",
  "metaKeywordsTemplate": ""
}
