{
  "templateKey": "system-default-ru-v1",
  "templateName": "系统默认模板 · 俄文",
  "locale": "ru",
  "version": 1,
  "schemaVersion": 1,
  "status": "active",
  "applicableArticleType": "novel_article",
  "bodyTemplate": "<article><h1>{novel_title}</h1>{if cover_url}<p><img src=\"{cover_url}\" alt=\"Обложка\"></p>{endif}<p>{novel_description}</p>{if total_chapter_count}<p>Всего глав: {total_chapter_count}</p>{endif}{if preview_chapter_count}<p>Доступно бесплатных ознакомительных глав: {preview_chapter_count}</p>{endif}{if promo_redirect_url}<p><a href=\"{promo_redirect_url}\">Начать чтение</a></p>{endif}</article>",
  "contentTemplate": [
    {
      "type": "heading",
      "content": "{novel_title}"
    },
    {
      "type": "image",
      "content": ""
    },
    {
      "type": "paragraph",
      "content": "{novel_description}"
    },
    {
      "type": "paragraph",
      "content": "{if total_chapter_count}Всего глав: {total_chapter_count}{endif}"
    },
    {
      "type": "paragraph",
      "content": "{if preview_chapter_count}Доступно бесплатных ознакомительных глав: {preview_chapter_count}{endif}"
    },
    {
      "type": "cta",
      "content": "Начать чтение"
    }
  ],
  "seoTemplate": {
    "title": "{novel_title}",
    "metaTitle": "{novel_title}",
    "metaDescription": "{novel_description}"
  },
  "slugTemplate": "",
  "metaKeywordsTemplate": ""
}
